---
const {
  image = "https://img.daisyui.com/images/stock/photo-1606107557195-0e29a4b5b4aa.webp",
  alt = "Image",
  title = "Card Title",
  badgeText = "NEW",
  description = "A card component has a figure, a body part, and inside body there are title and actions parts",
} = Astro.props;
---

<div class="card bg-base-100 md:w-96 w-fit shadow-sm h-full">
  <figure>
    <img src={image} alt={alt} />
  </figure>
  <div class="card-body">
    <h2 class="card-title">
      {title}
      {badgeText ? <div class="badge badge-neutral">{badgeText}</div> : null}
    </h2>
    <p>{description}</p>
  </div>
</div>
